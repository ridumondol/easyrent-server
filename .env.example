PORT=5000
NODE_ENV=development
MONGODB_URI=your_mongodb_connection_string
MONGODB_DB_NAME=rentora
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=7d

# Google OAuth (required for Google sign-in)
GOOGLE_CLIENT_ID=your_google_oauth_client_id

# GitHub OAuth (required for GitHub sign-in)
GITHUB_CLIENT_ID=your_github_oauth_client_id
GITHUB_CLIENT_SECRET=your_github_oauth_client_secret

# Client origin (for CORS and BetterAuth token verification)
CLIENT_URL=http://localhost:3000
# Additional allowed browser origins, comma-separated (optional)
CORS_ORIGIN=

# Booking settings
PENDING_BOOKING_HOLD_MINUTES=30

# Stripe payments
# Set these privately in your server environment. Never commit real values.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CURRENCY=bdt
# Optional local-only payment simulator. Ignored in production.
ENABLE_DEMO_PAYMENTS=false

# Email (SMTP; required for password resets and used for rental notifications)
SMTP_HOST=your_smtp_host
SMTP_PORT=587
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_password
EMAIL_FROM=Rentora <your_verified_sender>

# Demo seed credentials
SEED_ADMIN_NAME=Rentora Admin
SEED_ADMIN_EMAIL=your_admin_email
SEED_ADMIN_PASSWORD=replace_with_a_strong_admin_password
SEED_OWNER_NAME=Rentora Owner
SEED_OWNER_EMAIL=your_owner_email
SEED_OWNER_PASSWORD=replace_with_a_strong_owner_password
SEED_CUSTOMER_NAME=Rentora Customer
SEED_CUSTOMER_EMAIL=your_customer_email
SEED_CUSTOMER_PASSWORD=replace_with_a_strong_customer_password
